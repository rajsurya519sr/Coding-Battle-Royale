// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String?
  name         String?
  avatar       String?
  googleId     String?      @unique
  githubId     String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submissions  Submission[]
  lobbies      Lobby[]      @relation("LobbyPlayers")
  ownedLobbies Lobby[]      @relation("LobbyOwner")

  @@map("users")
}

model Question {
  id              String       @id @default(uuid())
  title           String
  description     String
  inputFormat     String
  outputFormat    String
  sampleTestCases Json
  constraints     Json
  hiddenTestCases Json
  difficulty      String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lobby           Lobby        @relation(fields: [lobbyId], references: [id])
  lobbyId         String
  submissions     Submission[]

  @@map("questions")
}

model Submission {
  id          String   @id @default(uuid())
  code        String
  language    String
  passedTests Int
  totalTests  Int
  score       Int
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  question    Question @relation(fields: [questionId], references: [id])
  questionId  String

  @@map("submissions")
}

model Lobby {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  status    String     @default("waiting") // waiting, active, completed
  round     Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  owner     User       @relation("LobbyOwner", fields: [ownerId], references: [id])
  ownerId   String
  players   User[]     @relation("LobbyPlayers")
  questions Question[]

  @@map("lobbies")
}
